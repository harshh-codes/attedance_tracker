# Landmark Developers - Backend Environment Configuration Template

NODE_ENV=production
PORT=5000

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/landmark_attendance?schema=public"

# JWT Authentication Secrets
JWT_SECRET="landmark_super_secret_jwt_key_2026_change_in_prod"
REFRESH_TOKEN_SECRET="landmark_refresh_super_secret_key_2026_change_in_prod"

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://attendance.landmarkdevelopers.com"

# SMTP Email Configuration (Optional - for real email dispatching)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM='"Landmark Developers HR" <noreply@landmarkdevelopers.com>'
